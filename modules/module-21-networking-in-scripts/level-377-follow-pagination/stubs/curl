#!/usr/bin/env bash
# curl stand-in for the paged invoice list: -s, -S, --fail. Logs every GET.
# fixtures/http/<host><path-with-query>.body, optional .status; a missing file is a 404.
silent=0 show_err=0 fail=0 url=
for arg in "$@"; do
  case $arg in
    -s|--silent) silent=1 ;;
    -S|--show-error) show_err=1 ;;
    -sS|-Ss) silent=1; show_err=1 ;;
    -f|--fail) fail=1 ;;
    -*) echo "curl: option $arg: is unknown" >&2
        echo "curl: try 'curl --help' or 'curl --manual' for more information" >&2
        exit 2 ;;
    *) url=$arg ;;
  esac
done
[[ -n $url ]] || { echo "curl: no URL specified" >&2; exit 2; }
echo "GET $url" >> .calls.log
rest=${url#*://}; host=${rest%%/*}; path=/${rest#*/}
base=fixtures/http/$host$path
code=404
[[ -f $base.body ]] && code=200
[[ -f $base.status ]] && code=$(tr -d '[:space:]' < "$base.status")
if (( fail && code >= 400 )); then
  if (( ! silent || show_err )); then echo "curl: (22) The requested URL returned error: $code" >&2; fi
  exit 22
fi
if [[ -f $base.body ]]; then cat "$base.body"; else echo '{"error":"not found"}'; fi
