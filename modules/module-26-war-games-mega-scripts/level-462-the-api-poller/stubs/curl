#!/usr/bin/env bash
# curl stand-in: -s -S -sS -f --fail --max-time N -X METHOD -H HEADER -d DATA URL
# GET  https://host/NAME  -> responses/NAME.json   (responses/NAME.fail => exit 7, no file => exit 22)
# POST anything           -> appended to .webhooks.log (a file named webhook.fail => exit 22)
method=GET data="" url=""
while (( $# )); do
  case $1 in
    -s|-S|-sS|-Ss|-f|--fail|-sSf|-fsS) ;;
    --max-time|-H) shift ;;
    -X) method=$2; shift ;;
    -d) data=$2; shift ;;
    -*) echo "curl: option $1: is unknown" >&2; exit 2 ;;
    *) url=$1 ;;
  esac
  shift
done
[[ -n $url ]] || { echo "curl: no URL specified" >&2; exit 2; }
echo "$method $url" >> .calls.log
if [[ $method == POST ]]; then
  if [[ -f webhook.fail ]]; then echo "curl: (22) The requested URL returned error: 503" >&2; exit 22; fi
  echo "$data" >> .webhooks.log
  exit 0
fi
name=${url##*/}
if [[ -f responses/$name.fail ]]; then echo "curl: (7) Failed to connect" >&2; exit 7; fi
if [[ ! -f responses/$name.json ]]; then echo "curl: (22) The requested URL returned error: 404" >&2; exit 22; fi
cat "responses/$name.json"
