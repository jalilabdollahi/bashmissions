#!/usr/bin/env bash
# Fake tailfeed for BashMissions: tailfeed SRC PIPE
# Streams the lines of SRC into PIPE (which must be a named pipe), a little
# slowly. If SRC cannot be read it says so and exits 1, after having opened
# and closed the pipe so a reader sees end-of-file instead of waiting forever.
if [[ $# -ne 2 ]]; then
  echo "usage: tailfeed SRC PIPE" >&2
  exit 2
fi
if [[ ! -p $2 ]]; then
  echo "tailfeed: $2 is not a named pipe (create it with mkfifo)" >&2
  exit 3
fi
exec 3> "$2"
if [[ ! -r $1 ]]; then
  echo "tailfeed: cannot read $1" >&2
  exit 1
fi
while IFS= read -r line || [[ -n $line ]]; do
  printf '%s\n' "$line" >&3
  sleep 0.05
done < "$1"
