#!/usr/bin/env bash
# Fake deploy for BashMissions: deploy SITE takes 0.3 s and prints nothing.
# Sites whose name ends in "-bad" fail with status 1. Start and end go to
# .calls.log so the checker can see how many ran at the same time.
if [[ $# -ne 1 ]]; then
  echo "usage: deploy SITE" >&2
  exit 2
fi
echo "start $1" >> .calls.log
sleep 0.3
echo "end $1" >> .calls.log
case $1 in
  *-bad) exit 1 ;;
esac
exit 0
