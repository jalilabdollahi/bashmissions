#!/usr/bin/env bash
# Fake CI build job: build-job --os OS --runtime VERSION
# Fails when "OS/VERSION" appears in the comma list FAKE_FAIL_JOBS. Calls are logged.
os="" rt=""
while (( $# )); do
  case $1 in
    --os)      [[ $# -ge 2 ]] || { echo "build-job: --os needs a value" >&2; exit 2; }; os=$2; shift 2 ;;
    --runtime) [[ $# -ge 2 ]] || { echo "build-job: --runtime needs a value" >&2; exit 2; }; rt=$2; shift 2 ;;
    *) echo "build-job: unknown option '$1'" >&2; exit 2 ;;
  esac
done
if [[ -z $os || -z $rt ]]; then
  echo "build-job: need both --os and --runtime" >&2
  exit 2
fi
echo "build-job --os $os --runtime $rt" >> .calls.log
case ",${FAKE_FAIL_JOBS:-}," in
  *",$os/$rt,"*) echo "build-job: compile error on $os/$rt" >&2; exit 1 ;;
esac
exit 0
